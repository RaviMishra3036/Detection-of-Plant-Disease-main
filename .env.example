# Optional: enables Gemini image screening. Keep the real value in a local .env
# or in the hosting provider's encrypted environment variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Providers are tried in this order after Gemini: Grok, OpenRouter, Hugging Face, NVIDIA, Ollama.
XAI_API_KEY=
XAI_MODEL=grok-2-vision-1212
XAI_BASE_URL=https://api.x.ai/v1/chat/completions
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1/chat/completions
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Final offline fallback. Start Ollama and pull this vision model once:
# ollama pull gemma3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=gemma3:4b